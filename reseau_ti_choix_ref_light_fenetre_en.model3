            <Option type="int" name="source" value="2"/>
            <Option type="QString" name="static_value" value="TEMPORARY_OUTPUT"/>
          </Option>
        </Option>
        <Option type="List" name="QUERY">
          <Option type="Map">
            <Option type="QString" name="expression" value=" '(&#xa;node[highway~&quot;motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link|tertiary|tertiary_link&quot;](' || array_to_string(array(y_min(  transform( @map_extent, @map_crs ,'EPSG:4326')) ,x_min( transform( @map_extent, @map_crs ,'EPSG:4326')), y_max( transform( @map_extent, @map_crs ,'EPSG:4326')),x_max( transform( @map_extent, @map_crs ,'EPSG:4326'))))  ||');&#xa;way[highway~&quot;motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link|tertiary|tertiary_link&quot;](' ||  array_to_string(array(y_min(  transform( @map_extent, @map_crs ,'EPSG:4326')) ,x_min( transform( @map_extent, @map_crs ,'EPSG:4326')), y_max( transform( @map_extent, @map_crs ,'EPSG:4326')),x_max(  transform( @map_extent, @map_crs ,'EPSG:4326')))) || ');&#xa;rel[highway~&quot;motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link|tertiary|tertiary_link&quot;](' || array_to_string(array(y_min( transform( @map_extent, @map_crs ,'EPSG:4326')) ,x_min( transform( @map_extent, @map_crs ,'EPSG:4326')), y_max(  transform( @map_extent, @map_crs ,'EPSG:4326')),x_max(  transform( @map_extent, @map_crs ,'EPSG:4326')))) || ');&#xa;);&#xa;(._;>;);&#xa;out;'  "/>
            <Option type="int" name="source" value="3"/>
          </Option>
        </Option>
        <Option type="List" name="SERVER">
          <Option type="Map">
            <Option type="int" name="source" value="2"/>
            <Option type="QString" name="static_value" value="https://overpass-api.de/api/interpreter"/>
          </Option>
        </Option>
        <Option type="List" name="TIMEOUT">
          <Option type="Map">
            <Option type="int" name="source" value="2"/>
            <Option type="int" name="static_value" value="2500"/>
          </Option>
        </Option>
      </Option>
    </Option>
  </Option>
  <Option type="Map" name="designerParameterValues">
    <Option type="QString" name="dpartement" value="'name'='Trelins', Trelins"/>
    <Option type="QString" name="repertoirersultat" value="D:/temp/"/>
  </Option>
  <Option name="groupBoxes"/>
  <Option type="Map" name="help">
    <Option type="QString" name="ALG_CREATOR" value="Patrick Palmier - Cerema Hauts-de-France"/>
    <Option type="QString" name="ALG_DESC" value="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8.3pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>This algorithm generates a road network from OSM for use in Musliw to calculate accessibility.&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>The road network will be created from the main roads in OSM (motorway, trunk, primary, secondary, tertiary, motorway_link, trunk_link, primary_link, secondary_link, tertiary_link) on the perimeter of the Qgis window displayed.&lt;/p>&lt;/body>&lt;/html>"/>
    <Option type="QString" name="ALG_HELP_CREATOR" value="Patrick Palmier"/>
    <Option type="QString" name="ALG_VERSION" value="1.0.0"/>
    <Option type="QString" name="EXAMPLES" value="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;br />&lt;/p>&lt;/body>&lt;/html>"/>
    <Option type="invalid" name="HELP_URL"/>
    <Option type="invalid" name="SHORT_DESCRIPTION"/>
    <Option type="QString" name="nom_de_couche_gnrique" value="Nom générique: permet de spécifier un nom pour le nommage des table résultats&#xa;"/>
    <Option type="QString" name="repertoirersultat" value="Nom du répertoire où seront créés les fichiers résultats"/>
    <Option type="QString" name="vitessemarche" value="Vitesse de marche à pied  par déafut sur les arcs du réseau routier (par défaut 4km/h)"/>
  </Option>
